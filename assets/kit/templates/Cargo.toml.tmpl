# Storybook workspace — generated by `sbk scaffold` from the kit templates.
# Own detached workspace; the kit is vendored at `kit/` (SKILL.md "Setup").
[workspace]
resolver = "3"
# kit/ is vendored with a workspace of its own.
exclude = ["kit"]

[package]
name = "storybook"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
# The host crate owning the views; `sbk scaffold` fills the placeholders.
host = { package = "{{HOST_CRATE}}", path = "{{HOST_PATH}}" }
storybook-kit = { path = "kit" }
storybook-viewer = { path = "kit/viewer" }
gtk4 = { version = "0.11", features = ["v4_14"] }
serde_json = "1"
