//! Host registry — generated by `sbk scaffold`, then filled in by you
//! (SKILL.md step 6).
//!
//! One arm per view from `inventory.json`: deserialize the fixture JSON into
//! the host's view-model type, build the host's `Actions` value so every
//! callback records itself in the Events log, and return the widget from the
//! host's `build`.

use storybook_viewer::{Events, Registry};

pub struct HostRegistry;

impl Registry for HostRegistry {
