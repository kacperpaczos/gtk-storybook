//! Storybook binary — generated by `sbk scaffold` from the kit template.
//!
//! The storybook directory (inventory.json, fixtures/, flows.toml,
//! layout.json) is this crate's own directory; the viewer parses the
//! `--story <id>` and `--check-render` flags itself.

mod registry;

fn main() {
    let storybook_dir = std::path::Path::new(env!("CARGO_MANIFEST_DIR"));
    let exit_code = storybook_viewer::run(Box::new(registry::HostRegistry), storybook_dir);
    std::process::exit(i32::from(exit_code));
}
